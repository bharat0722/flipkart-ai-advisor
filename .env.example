# Phase 1 and Phase 2 need no credentials. Phase 3 needs an OpenAI-compatible LLM (copy to .env, never commit it).
OPENAI_API_KEY=your-api-key-here
# Optional: another OpenAI-compatible provider, e.g. https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_BASE_URL=
# Optional: model name (default gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini
# Optional: run the live-LLM test in tests/test_rag.py
# RUN_LLM_TESTS=1
# Optional: run the real-index acceptance tests in tests/test_retrieval.py
# RUN_MODEL_TESTS=1
# Optional: Hugging Face cache location for the downloaded embedding model
# HF_HOME=.cache/huggingface
